---
import Site from '../../layouts/Site.astro';
import { getLocaleFromUrl, useTranslations, locales } from '../../i18n/t';
import GrowthChart from '../../components/GrowthChart';
import FaqAccordion from '../../components/FaqAccordion.astro';

export async function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale: locale === 'en' ? undefined : locale },
  }));
}

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const investorFaq = [
  { q: t('faq.investor.q1'), a: t('faq.investor.a1') },
  { q: t('faq.investor.q2'), a: t('faq.investor.a2') },
  { q: t('faq.investor.q3'), a: t('faq.investor.a3') },
];
---

<Site title={`${t('nav.investors')} | WifiSenseBox`} description={t('investors.subtitle')}>
  <div class="bg-slate-50 py-16 sm:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h1 class="text-4xl font-extrabold text-slate-900 sm:text-5xl tracking-tight">
          {t('investors.title')}
        </h1>
        <p class="mt-4 text-xl text-slate-600">
          {t('investors.subtitle')}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center mb-24">
        <div>
          <h2 class="text-3xl font-bold text-slate-900 mb-6">{t('investors.mission.title')}</h2>
          <p class="text-lg text-slate-600 leading-relaxed">
            {t('investors.mission.text')}
          </p>
          <div class="mt-8 p-6 bg-blue-600 rounded-2xl text-white shadow-xl shadow-blue-200">
            <p class="text-sm font-semibold uppercase tracking-wider mb-2">{t('investors.tam.label')}</p>
            <p class="text-3xl font-bold">{t('investors.tam.value')}</p>
            <p class="text-blue-100 text-sm mt-1">{t('investors.tam.sub')}</p>
          </div>
        </div>
        <div class="bg-white p-8 rounded-3xl shadow-sm border border-slate-100">
          <h3 class="text-2xl font-bold text-slate-900 mb-6">{t('investors.plan.title')}</h3>
          <p class="text-slate-600 mb-6">
            {t('investors.plan.text')}
          </p>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <div class="h-6 w-6 rounded-full bg-green-100 text-green-600 flex items-center justify-center flex-shrink-0">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
              </div>
              <span class="text-slate-700 font-medium">{t('investors.bullets.margins')}</span>
            </li>
            <li class="flex items-start gap-3">
              <div class="h-6 w-6 rounded-full bg-green-100 text-green-600 flex items-center justify-center flex-shrink-0">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
              </div>
              <span class="text-slate-700 font-medium">{t('investors.bullets.churn')}</span>
            </li>
            <li class="flex items-start gap-3">
              <div class="h-6 w-6 rounded-full bg-green-100 text-green-600 flex items-center justify-center flex-shrink-0">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
              </div>
              <span class="text-slate-700 font-medium">{t('investors.bullets.moat')}</span>
            </li>
          </ul>
        </div>
      </div>

      <div class="mb-24">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-slate-900 mb-4">{t('investors.growth.title')}</h2>
          <p class="text-lg text-slate-600 max-w-2xl mx-auto">
            {t('investors.growth.text')}
          </p>
        </div>
        <GrowthChart
          client:load
          title={t('investors.chart.title')}
          subtitle={t('investors.chart.sub')}
          badge={t('investors.chart.badge')}
          unitsLabel={t('investors.chart.units')}
          arrLabel={t('investors.chart.arr')}
          footer1={t('investors.chart.footer1')}
          footer2={t('investors.chart.footer2')}
        />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-24">
        <div class="bg-white p-8 rounded-2xl border border-slate-100">
          <div class="h-12 w-12 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center mb-6">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-7h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
          </div>
          <h4 class="font-bold text-slate-900 mb-2">{t('investors.potential.senior')}</h4>
          <p class="text-sm text-slate-600">{t('investors.potential.point1')}</p>
        </div>
        <div class="bg-white p-8 rounded-2xl border border-slate-100">
          <div class="h-12 w-12 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center mb-6">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          </div>
          <h4 class="font-bold text-slate-900 mb-2">{t('investors.potential.commercial')}</h4>
          <p class="text-sm text-slate-600">{t('investors.potential.point2')}</p>
        </div>
        <div class="bg-white p-8 rounded-2xl border border-slate-100">
          <div class="h-12 w-12 bg-purple-50 text-purple-600 rounded-xl flex items-center justify-center mb-6">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" /></svg>
          </div>
          <h4 class="font-bold text-slate-900 mb-2">{t('investors.potential.industrial')}</h4>
          <p class="text-sm text-slate-600">{t('investors.potential.point3')}</p>
        </div>
      </div>

      <div class="bg-slate-900 rounded-3xl p-12 text-center text-white relative overflow-hidden">
        <div class="relative z-10">
          <h2 class="text-3xl font-bold mb-4">{t('investors.final.title')}</h2>
          <p class="text-slate-400 mb-8 max-w-xl mx-auto">
            {t('investors.final.text')}
          </p>
          <a href={locale === 'de' ? '/de/contact' : '/contact'} class="inline-flex items-center px-8 py-4 border border-transparent text-lg font-medium rounded-full shadow-sm text-slate-900 bg-white hover:bg-slate-100 transition-colors">
            {t('investors.cta')}
          </a>
        </div>
        <div class="absolute top-0 right-0 -translate-y-1/2 translate-x-1/2 w-96 h-96 bg-blue-500 rounded-full blur-[120px] opacity-20"></div>
        <div class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/2 w-96 h-96 bg-purple-500 rounded-full blur-[120px] opacity-20"></div>
      </div>

      <div class="mt-24 max-w-3xl mx-auto">
        <FaqAccordion faq={investorFaq} />
      </div>
    </div>
  </div>
</Site>
