---
import Site from '../../layouts/Site.astro';
import ROICalculator from '../../components/ROICalculator';
import WaitlistForm from '../../components/WaitlistForm.astro';
import { defaultLocale, useTranslations } from '../../i18n/t';

export function getStaticPaths() {
  return [
    { params: { locale: undefined }, locale: 'en' },
    { params: { locale: 'de' }, locale: 'de' },
  ];
}

const locale = (Astro.currentLocale || defaultLocale) as 'en' | 'de';
const t = useTranslations(locale);
const isDe = locale === 'de';

const title = isDe ? 'ROI-Rechner | WifiSenseBox' : 'ROI Calculator | WifiSenseBox';
const description = isDe
  ? 'Berechnen Sie in 30 Sekunden, wie viel WifiSenseBox Ihrem Betrieb pro Jahr sparen kann — über alle Anwendungsfälle hinweg.'
  : 'Calculate in 30 seconds how much WifiSenseBox can save your operation per year — across every use case.';

const initial = (Astro.url.searchParams.get('uc') || '') as string;
---
<Site title={title} description={description}>
  <section class="relative overflow-hidden bg-gradient-to-b from-slate-50 to-white">
    <div class="absolute inset-x-0 top-0 h-64 bg-gradient-to-b from-blue-50/60 to-transparent pointer-events-none"></div>
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-10 text-center">
      <span class="inline-block text-xs font-bold uppercase tracking-widest text-blue-600 mb-3">
        {isDe ? 'Interaktiver Rechner' : 'Interactive Calculator'}
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 leading-tight mb-4">
        {isDe ? 'Wie viel kostet Sie das' : 'How much is the'}<br />
        <span class="bg-gradient-to-r from-blue-600 to-blue-500 bg-clip-text text-transparent">
          {isDe ? 'aktuelle System wirklich?' : 'status quo costing you?'}
        </span>
      </h1>
      <p class="text-lg text-slate-600 max-w-2xl mx-auto">
        {isDe
          ? 'Wählen Sie Ihren Anwendungsfall, passen Sie 2–3 Zahlen an und sehen Sie sofort, was WifiSenseBox Ihnen sparen würde.'
          : 'Pick your use case, drag 2–3 sliders, and see exactly what WifiSenseBox would save you — in dollars, payback months, and 5-year net.'}
      </p>
    </div>
  </section>

  <section class="pb-20 -mt-2">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <ROICalculator client:load initialUseCase={initial || undefined} locale={locale} />

      <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
        <div class="p-4 rounded-xl bg-blue-50/70 border border-blue-100">
          <div class="font-bold text-slate-900 mb-1">{isDe ? 'Konservative Annahmen' : 'Conservative assumptions'}</div>
          <p class="text-slate-600">{isDe
            ? 'Wir nehmen branchenübliche Mittelwerte — kein Marketing-Aufschlag.'
            : 'Industry-median recovery rates. No hand-waved 10× marketing math.'}</p>
        </div>
        <div class="p-4 rounded-xl bg-blue-50/70 border border-blue-100">
          <div class="font-bold text-slate-900 mb-1">{isDe ? 'Einmalige Hardware' : 'One-time hardware'}</div>
          <p class="text-slate-600">{isDe
            ? '199 € einmalig pro Router. Keine Hubs, keine NVRs, keine versteckten Gebühren.'
            : '$199 one-time per router. No hubs, no NVRs, no hidden fees.'}</p>
        </div>
        <div class="p-4 rounded-xl bg-blue-50/70 border border-blue-100">
          <div class="font-bold text-slate-900 mb-1">{isDe ? '100% DSGVO-konform' : '100% GDPR-compliant'}</div>
          <p class="text-slate-600">{isDe
            ? 'Keine Kameras, keine Bilder, keine personenbezogenen Daten.'
            : 'No cameras, no images, no personal data ever leaves the device.'}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-slate-900 rounded-3xl p-8 md:p-12 text-white relative overflow-hidden">
        <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-8">
          <div class="max-w-xl text-left">
            <h2 class="text-3xl font-bold mb-4">{locale === 'de' ? 'Interessiert an der Skalierung?' : 'Interested in the Scale?'}</h2>
            <p class="text-slate-400 text-lg">
              {locale === 'de' 
                ? 'Unsere ROI-Zahlen sind erst der Anfang. Entdecken Sie unser Geschäftsmodell und wie wir planen, den 120-Milliarden-Dollar-Markt für Sensorik zu dominieren.' 
                : 'Our ROI numbers are just the beginning. Discover our business model and how we plan to dominate the $120B sensing market.'}
            </p>
          </div>
          <a href={locale === 'de' ? '/de/investor-relations' : '/investor-relations'} class="inline-flex items-center px-8 py-4 rounded-full bg-blue-600 hover:bg-blue-700 text-white font-bold transition-colors whitespace-nowrap">
            {t('nav.investors')}
            <svg class="ml-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </a>
        </div>
        <div class="absolute top-0 right-0 -translate-y-1/2 translate-x-1/2 w-64 h-64 bg-blue-500/20 rounded-full blur-3xl"></div>
      </div>
    </div>
  </section>

  <section id="waitlist" class="py-20 bg-slate-900 text-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-extrabold mb-4">
        {isDe ? 'Sichern Sie sich Ihren Pilot-Slot' : 'Lock in your pilot slot'}
      </h2>
      <p class="text-lg text-slate-300 mb-8">
        {isDe
          ? 'Founders Edition: 199 $ Router + 1 Monat Software gratis für die ersten 1.000 Anmeldungen.'
          : "Founders Edition: $199 router + 1 month of software free for the first 1,000 sign-ups."}
      </p>
      <div class="flex justify-center">
        <WaitlistForm locale={locale} variant="dark" usecase="roi-calculator" />
      </div>
    </div>
  </section>
</Site>
