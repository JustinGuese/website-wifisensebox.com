---
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';
import LocaleSwitcher from '../components/LocaleSwitcher.astro';
import { getLocaleFromUrl, useTranslations, getRelativePath, locales, defaultLocale } from '../i18n/t';
import { getCollection } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
}

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const { 
  title = "WifiSenseBox", 
  description = "See without seeing. Privacy-first ambient sensing for the spaces you care about."
} = Astro.props;

const l = (path: string) => {
  if (locale === defaultLocale) return path;
  return `/${locale}${path === '/' ? '' : path}`;
};

// Fetch categories and use cases for the nav
const allCategories = await getCollection('categories', (entry) => entry.data.locale === locale);
const allUseCases = await getCollection('usecases', (entry) => entry.data.locale === locale);

// Ensure rank order
const sortedCategories = allCategories.sort((a, b) => a.data.rank - b.data.rank);
const getUseCasesForCategory = (catId) => {
  return allUseCases
    .filter(uc => uc.data.category === catId)
    .sort((a, b) => a.data.rank - b.data.rank)
    .slice(0, 3);
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL("/productimage.jpg", Astro.url)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL("/productimage.jpg", Astro.url)} />

    <slot name="head" />
  </head>
  <body class="bg-white text-slate-900 font-sans antialiased flex flex-col min-h-screen">
    <header class="border-b border-slate-100 py-4 relative z-50 bg-white">
      <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between items-center">
        <a href={l('/')} class="flex items-center text-2xl font-bold text-slate-900">
          <img src="/logo.png" alt="WifiSenseBox Logo" class="h-8 w-auto mr-2" />
          WifiSenseBox
        </a>
        
        <div class="hidden md:flex space-x-6 text-sm font-medium text-slate-600 items-center">
          <a href={l('/how-it-works')} class="hover:text-slate-900 py-2">{t('nav.how_it_works')}</a>

          {sortedCategories.map(cat => {
            // Strip .de or .en extension if present
            const catId = cat.id.split('.')[0]; 
            const ucs = getUseCasesForCategory(catId);
            return (
            <div class="relative group">
              <a href={l(`/${catId}`)} class="flex items-center hover:text-slate-900 py-2">
                {cat.data.title}
                <svg class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </a>
              <div class="absolute left-0 w-56 pt-2 hidden group-hover:block z-50">
                <div class="bg-white border border-slate-100 rounded-md shadow-lg py-1">
                  {ucs.map(uc => {
                    const ucId = uc.id.split('.')[0];
                    return (
                    <a href={l(`/${catId}/${ucId}`)} class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50">{uc.data.title}</a>
                  )})}
                  <div class="border-t border-slate-100 mt-1 pt-1">
                    <a href={l('/roi-calculator')} class="flex items-center gap-2 px-4 py-2 text-sm font-semibold text-blue-600 hover:bg-slate-50">
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m-6 4h6m-6 4h6M5 5h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2z"/></svg>
                      {locale === 'de' ? 'ROI-Rechner' : 'ROI Calculator'}
                    </a>
                  </div>
                </div>
              </div>
            </div>
          )})}

          <div class="relative group">
            <a href={l('/impressum')} class="flex items-center hover:text-slate-900 py-2">
              {locale === 'de' ? 'Rechtliches' : 'Legal'}
              <svg class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </a>
            <div class="absolute right-0 w-48 pt-2 hidden group-hover:block z-50">
              <div class="bg-white border border-slate-100 rounded-md shadow-lg py-1">
                <a href={l('/impressum')} class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50">Impressum</a>
                <a href={l('/datenschutz')} class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50">{locale === 'de' ? 'Datenschutz' : 'Privacy'}</a>
                <a href={l('/agb')} class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50">{locale === 'de' ? 'AGB' : 'Terms'}</a>
              </div>
            </div>
          </div>

          <a href={l('/contact')} class="hover:text-slate-900 py-2">{locale === 'de' ? 'Kontakt' : 'Contact'}</a>

          <LocaleSwitcher />
        </div>
        <div class="flex items-center gap-2">
          <a href="#waitlist" class="hidden sm:inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700">
            {t('nav.waitlist')}
          </a>
          <button
            id="mobile-menu-toggle"
            type="button"
            class="md:hidden inline-flex items-center justify-center h-10 w-10 rounded-md text-slate-700 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
            aria-label="Toggle navigation menu"
            aria-controls="mobile-menu"
            aria-expanded="false"
          >
            <svg id="mobile-menu-icon-open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
            <svg id="mobile-menu-icon-close" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>
        </div>
      </nav>

      <div id="mobile-menu" class="md:hidden hidden border-t border-slate-100 bg-white">
        <div class="px-4 py-3 space-y-1 text-sm font-medium text-slate-700 max-h-[80vh] overflow-y-auto">
          <a href={l('/how-it-works')} class="block px-3 py-2 rounded-md hover:bg-slate-50">{t('nav.how_it_works')}</a>

          {sortedCategories.map(cat => {
            const catId = cat.id.split('.')[0];
            const ucs = getUseCasesForCategory(catId);
            return (
              <details class="group">
                <summary class="flex items-center justify-between px-3 py-2 rounded-md hover:bg-slate-50 cursor-pointer list-none">
                  <span>{cat.data.title}</span>
                  <svg class="h-4 w-4 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                </summary>
                <div class="pl-4 py-1 space-y-1">
                  {ucs.map(uc => {
                    const ucId = uc.id.split('.')[0];
                    return (
                      <a href={l(`/${catId}/${ucId}`)} class="block px-3 py-2 text-sm text-slate-600 hover:bg-slate-50 rounded-md">{uc.data.title}</a>
                    );
                  })}
                  <a href={l('/roi-calculator')} class="block px-3 py-2 text-sm font-semibold text-blue-600 hover:bg-slate-50 rounded-md">
                    {locale === 'de' ? 'ROI-Rechner' : 'ROI Calculator'}
                  </a>
                </div>
              </details>
            );
          })}

          <details class="group">
            <summary class="flex items-center justify-between px-3 py-2 rounded-md hover:bg-slate-50 cursor-pointer list-none">
              <span>{locale === 'de' ? 'Rechtliches' : 'Legal'}</span>
              <svg class="h-4 w-4 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="pl-4 py-1 space-y-1">
              <a href={l('/impressum')} class="block px-3 py-2 text-sm text-slate-600 hover:bg-slate-50 rounded-md">Impressum</a>
              <a href={l('/datenschutz')} class="block px-3 py-2 text-sm text-slate-600 hover:bg-slate-50 rounded-md">{locale === 'de' ? 'Datenschutz' : 'Privacy'}</a>
              <a href={l('/agb')} class="block px-3 py-2 text-sm text-slate-600 hover:bg-slate-50 rounded-md">{locale === 'de' ? 'AGB' : 'Terms'}</a>
            </div>
          </details>

          <a href={l('/contact')} class="block px-3 py-2 rounded-md hover:bg-slate-50">{locale === 'de' ? 'Kontakt' : 'Contact'}</a>

          <div class="border-t border-slate-100 mt-2 pt-2 flex items-center gap-2">
            {locales.map((loc) => (
              <a
                href={getRelativePath(Astro.url, loc)}
                class:list={[
                  'px-3 py-1.5 rounded-md text-xs font-bold uppercase tracking-widest',
                  locale === loc ? 'bg-slate-900 text-white' : 'text-slate-600 hover:bg-slate-100'
                ]}
              >
                {loc}
              </a>
            ))}
          </div>

          <a href="#waitlist" class="block mt-2 px-3 py-3 rounded-md text-center text-white bg-blue-600 hover:bg-blue-700 font-semibold">
            {t('nav.waitlist')}
          </a>
        </div>
      </div>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    <footer class="bg-slate-50 border-t border-slate-200 py-8 mt-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-sm text-slate-500">
        <p>&copy; {new Date().getFullYear()} WifiSenseBox. All rights reserved.</p>
        <div class="mt-4 space-x-4">
          <a href={l('/contact')} class="hover:text-slate-900">{locale === 'de' ? 'Kontakt' : 'Contact'}</a>
          <a href={l('/impressum')} class="hover:text-slate-900">Impressum</a>
          <a href={l('/datenschutz')} class="hover:text-slate-900">Datenschutz</a>
          <a href={l('/agb')} class="hover:text-slate-900">{locale === 'de' ? 'AGB' : 'Terms'}</a>
        </div>
      </div>
    </footer>
    <CookieBanner />

    <div
      id="sticky-cta"
      class="md:hidden fixed inset-x-0 bottom-0 z-40 translate-y-full opacity-0 transition-all duration-300 pointer-events-none"
      aria-hidden="true"
    >
      <div class="bg-white/95 backdrop-blur border-t border-slate-200 shadow-[0_-4px_20px_rgba(15,23,42,0.08)] px-4 py-3 pb-[calc(env(safe-area-inset-bottom)+0.75rem)]">
        <a
          href="#waitlist"
          class="flex items-center justify-center gap-2 w-full py-3.5 rounded-xl text-base font-semibold text-white bg-gradient-to-r from-blue-600 to-blue-700 shadow-md shadow-blue-600/25 active:scale-[0.98] transition-transform"
        >
          {t('nav.waitlist')}
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>
        </a>
      </div>
    </div>

    <script is:inline>
      (() => {
        const btn = document.getElementById('mobile-menu-toggle');
        const menu = document.getElementById('mobile-menu');
        const iconOpen = document.getElementById('mobile-menu-icon-open');
        const iconClose = document.getElementById('mobile-menu-icon-close');
        if (btn && menu) {
          const setOpen = (open) => {
            menu.classList.toggle('hidden', !open);
            btn.setAttribute('aria-expanded', open ? 'true' : 'false');
            iconOpen?.classList.toggle('hidden', open);
            iconClose?.classList.toggle('hidden', !open);
          };
          btn.addEventListener('click', () => {
            setOpen(menu.classList.contains('hidden'));
          });
          menu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setOpen(false)));
        }
      })();
      (() => {
        const bar = document.getElementById('sticky-cta');
        if (!bar) return;
        const show = () => {
          bar.classList.remove('translate-y-full', 'opacity-0', 'pointer-events-none');
          bar.setAttribute('aria-hidden', 'false');
        };
        const hide = () => {
          bar.classList.add('translate-y-full', 'opacity-0', 'pointer-events-none');
          bar.setAttribute('aria-hidden', 'true');
        };

        const heroForm = document.querySelector('.waitlist-form-container');
        const waitlist = document.getElementById('waitlist');
        const observed = [heroForm, waitlist].filter(Boolean);

        if ('IntersectionObserver' in window && observed.length) {
          let visibleAnchors = 0;
          const io = new IntersectionObserver((entries) => {
            entries.forEach(e => { visibleAnchors += e.isIntersecting ? 1 : -1; });
            visibleAnchors = Math.max(0, visibleAnchors);
            if (window.scrollY > 400 && visibleAnchors === 0) show(); else hide();
          }, { threshold: 0.05 });
          observed.forEach(el => io.observe(el));
          window.addEventListener('scroll', () => {
            if (window.scrollY > 400 && visibleAnchors === 0) show(); else if (window.scrollY <= 400) hide();
          }, { passive: true });
        } else {
          window.addEventListener('scroll', () => {
            if (window.scrollY > 400) show(); else hide();
          }, { passive: true });
        }
      })();
    </script>
  </body>
</html>
</html>
