---
import { useTranslations } from '../i18n/t';

interface Props {
  usecase?: string;
  locale?: string;
  ctaText?: string;
  variant?: 'light' | 'dark';
  showFinePrint?: boolean;
  showTrustBadges?: boolean;
}
const {
  usecase = 'general',
  locale = 'en',
  ctaText,
  variant = 'light',
  showFinePrint = true,
  showTrustBadges = true,
} = Astro.props;

const t = useTranslations(locale as any);
const buttonText = ctaText || t('waitlist.cta_alt');

const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID || 'xnjrdjwg';
const landingPage = Astro.url.pathname;

const isDark = variant === 'dark';
---

<div class="waitlist-form-container w-full max-w-lg">
  <form
    action={`https://formspree.io/f/${formspreeId}`}
    method="POST"
    class="flex flex-col sm:flex-row gap-2 p-1.5 rounded-xl ring-1 ring-slate-200 bg-white shadow-lg shadow-slate-900/5 sm:items-stretch"
    class:list={[isDark && '!bg-white/10 !ring-white/20']}
  >
    <input type="hidden" name="usecase" value={usecase} />
    <input type="hidden" name="locale" value={locale} />
    <input type="hidden" name="landing_page" value={landingPage} />
    <input type="hidden" name="_next" value={`${landingPage}${landingPage.includes('?') ? '&' : '?'}subscribed=1#waitlist`} />
    <input type="text" name="_gotcha" style="display:none" />

    <label for="email-address" class="sr-only">Email address</label>
    <input
      id="email-address"
      name="email"
      type="email"
      autocomplete="email"
      required
      class={`flex-grow min-w-0 appearance-none border-0 bg-transparent rounded-lg py-3 px-4 text-base focus:outline-none focus:ring-0 ${isDark ? 'text-white placeholder-white/60' : 'text-slate-900 placeholder-slate-400'}`}
      placeholder={locale === 'de' ? 'Ihre E-Mail-Adresse' : 'you@company.com'}
    />

    <button
      type="submit"
      class="group inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg text-base font-semibold text-white bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 shadow-md shadow-blue-600/25 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-transform active:scale-[0.98] whitespace-nowrap"
    >
      {buttonText}
      <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>
    </button>
  </form>

  {showTrustBadges && (
    <div class={`mt-4 flex flex-wrap items-center gap-4 text-[10px] font-bold uppercase tracking-widest ${isDark ? 'text-blue-200/60' : 'text-slate-400'}`}>
      <div class="flex items-center gap-1.5">
        <svg class="h-3.5 w-3.5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
        {t('waitlist.trust.gdpr')}
      </div>
      <div class="flex items-center gap-1.5">
        <svg class="h-3.5 w-3.5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
        {t('waitlist.trust.no_cc')}
      </div>
      <div class="flex items-center gap-1.5">
        <svg class="h-3.5 w-3.5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
        {t('waitlist.trust.encryption')}
      </div>
    </div>
  )}

  {showFinePrint && (
    <div class="mt-4 flex items-center gap-2">
      <div class="flex -space-x-2">
        <img src="https://randomuser.me/api/portraits/women/44.jpg" alt="" loading="lazy" class="h-6 w-6 rounded-full ring-2 ring-white object-cover" />
        <img src="https://randomuser.me/api/portraits/men/32.jpg" alt="" loading="lazy" class="h-6 w-6 rounded-full ring-2 ring-white object-cover" />
        <img src="https://randomuser.me/api/portraits/women/68.jpg" alt="" loading="lazy" class="h-6 w-6 rounded-full ring-2 ring-white object-cover" />
      </div>
      <p class:list={["text-xs", isDark ? 'text-white/70' : 'text-slate-500']}>
        <span class="font-bold text-blue-500">{t('hero.social_proof')}</span>. {t('waitlist.limit')}
      </p>
    </div>
  )}
</div>

<script is:inline>
  (() => {
    const params = new URLSearchParams(window.location.search);
    if (params.get('subscribed') !== '1') return;
    if (typeof window.fbq === 'function') {
      window.fbq('track', 'Lead', {
        content_name: 'Waitlist Subscription',
        content_category: 'Waitlist'
      });
    }
    params.delete('subscribed');
    const qs = params.toString();
    const newUrl = window.location.pathname + (qs ? '?' + qs : '') + window.location.hash;
    window.history.replaceState({}, '', newUrl);
  })();
</script>
