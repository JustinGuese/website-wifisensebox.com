---
import { useTranslations, defaultLocale } from '../i18n/t';
import type { Locale } from '../i18n/t';

const locale = (Astro.currentLocale || defaultLocale) as Locale;
const t = useTranslations(locale);

const tiers = [
  {
    name: t('pricing.tier1.name'),
    price: t('pricing.tier1.price'),
    period: t('pricing.period'),
    hardware: t('pricing.tier1.hardware'),
    description: t('pricing.tier1.desc'),
    features: [
      t('pricing.tier1.f1'),
      t('pricing.tier1.f2'),
      t('pricing.tier1.f3'),
      t('pricing.tier1.f4'),
    ],
    cta: t('nav.waitlist')
  },
  {
    name: t('pricing.tier2.name'),
    price: t('pricing.tier2.price'),
    period: t('pricing.period'),
    hardware: t('pricing.tier2.hardware'),
    description: t('pricing.tier2.desc'),
    features: [
      t('pricing.tier2.f1'),
      t('pricing.tier2.f2'),
      t('pricing.tier2.f3'),
      t('pricing.tier2.f4'),
    ],
    cta: t('pricing.tier2.cta'),
    highlight: true
  },
  {
    name: t('pricing.tier3.name'),
    price: t('pricing.tier3.price'),
    period: t('pricing.period'),
    hardware: t('pricing.tier3.hardware'),
    description: t('pricing.tier3.desc'),
    features: [
      t('pricing.tier3.f1'),
      t('pricing.tier3.f2'),
      t('pricing.tier3.f3'),
      t('pricing.tier3.f4'),
    ],
    cta: t('pricing.tier3.cta')
  }
];
---

<div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12">
  {tiers.map((tier) => (
    <div class={`relative flex flex-col p-8 rounded-2xl border ${tier.highlight ? 'border-blue-600 bg-blue-50/50 ring-4 ring-blue-600/10' : 'border-slate-200 bg-white shadow-sm'}`}>
      {tier.highlight && (
        <span class="absolute top-0 right-8 -translate-y-1/2 bg-blue-600 text-white text-[10px] font-bold uppercase tracking-widest px-3 py-1 rounded-full">{t('pricing.badge')}</span>
      )}
      <h3 class="text-xl font-bold text-slate-900">{tier.name}</h3>
      
      <div class="mt-4 flex items-baseline gap-1">
        <span class="text-4xl font-bold tracking-tight text-slate-900">{tier.price}</span>
        <span class="text-sm font-semibold text-slate-500">{tier.period}</span>
      </div>
      <div class="mt-1 text-sm font-bold text-blue-600 tracking-tight">{tier.hardware}</div>
      
      <p class="mt-4 text-sm text-slate-600 leading-relaxed">{tier.description}</p>
      
      <ul class="mt-8 space-y-3 flex-grow">
        {tier.features.map(feature => (
          <li class="flex items-center gap-3 text-sm text-slate-700 font-medium">
            <svg class="h-5 w-5 text-blue-600 shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            {feature}
          </li>
        ))}
      </ul>

      <a href="#waitlist" class={`mt-8 w-full py-3 px-6 rounded-xl font-bold transition-all text-center ${tier.highlight ? 'bg-blue-600 text-white hover:bg-blue-700 shadow-lg shadow-blue-600/20' : 'bg-slate-900 text-white hover:bg-slate-800'}`}>
        {tier.cta}
      </a>
    </div>
  ))}
</div>
